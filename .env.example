# Copy to .env for local tweaks. Kai runs fine with none of these set.
#
# Override the Vite dev server URL the main process loads in `npm run dev`.
# KAI_DEV_SERVER=http://localhost:5173
#
# Per app environment variables are NOT set here. Add those in the app's
# edit dialog inside Kai, so they are saved with the app and applied on top
# of the inherited environment when the command is spawned.
