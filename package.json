{
  "name": "kai",
  "productName": "Kai",
  "version": "0.1.1",
  "description": "Kai — a personal dev-server launcher. Save your projects once, start them with one click.",
  "main": "electron/main.js",
  "license": "MIT",
  "author": {
    "name": "omthorat"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env KAI_DEV_SERVER=http://localhost:5173 electron .\"",
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:win": "npm run build:renderer && electron-builder --win",
    "test": "node test/pm-test.js",
    "test:e2e": "npm run build:renderer && node test/drive.mjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.omthorat.kai",
    "productName": "Kai",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*.{md,markdown,ts,map,flow}",
      "!node_modules/**/{test,tests,__tests__,doc,docs,example,examples,.github,.idea}/**",
      "!node_modules/**/{LICENSE,license,LICENSE.txt,AUTHORS,CHANGELOG.md,.editorconfig,.eslintrc,.npmignore}"
    ],
    "compression": "maximum",
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "omthorat2004",
        "repo": "Kai"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Kai-${version}-${arch}.${ext}",
      "identity": null,
      "electronLanguages": [
        "en-US"
      ]
    },
    "dmg": {
      "title": "Kai ${version} ${arch}",
      "format": "UDBZ"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Kai-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Kai"
    }
  }
}
